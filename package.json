{
  "name": "@feedsbrain/pssh-tools",
  "version": "1.2.2",
  "description": "Tools to generate PSSH Data and PSSH Box",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "eslint . && tsc -p . && cp -R ./src/lib/pssh/proto ./dist/src/lib/pssh/",
    "prepare": "npm run build",
    "pretest": "npm run build",
    "test": "c8 ava",
    "lint": "eslint . --fix",
    "pub": "npm version patch --force && npm publish"
  },
  "keywords": [
    "pssh",
    "tools",
    "pssh-box",
    "pssh-data",
    "cenc",
    "drm"
  ],
  "author": "Indra Gunawan <feedsbrain@gmail.com>",
  "license": "BSD",
  "dependencies": {
    "protobufjs": "^8.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "ava": "^6.4.1",
    "c8": "^10.1.3",
    "eslint": "^9.39.5",
    "neostandard": "^0.13.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "files": [
    "dist/src/*",
    "dist/src/**/*"
  ],
  "ava": {
    "files": [
      "./test/**/*.ts"
    ],
    "extensions": {
      "ts": "commonjs"
    },
    "nodeArguments": [
      "--import=tsx"
    ]
  },
  "c8": {
    "reporter": [
      "lcov",
      "text"
    ],
    "include": [
      "src/**/*.ts"
    ],
    "all": true
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
